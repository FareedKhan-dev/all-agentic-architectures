# =============================================================================
# all-agentic-architectures: environment variables
# Copy this file to `.env` and fill in your own values.  .env is gitignored.
# =============================================================================

# ---------------------------------------------------------------------------
# 1.  LLM PROVIDER SELECTION
# ---------------------------------------------------------------------------
# Pick ONE provider: every notebook and every architecture in the library will
# use whichever provider you set here, with no code changes.
#
# Supported values:
#   nebius | openai | anthropic | deepseek | groq | ollama | together | fireworks |
#   mistralai | google | openrouter | huggingface
#
LLM_PROVIDER=nebius

# Model name for the chosen provider. Leave it empty for the provider's recommended
# model (src/agentic_architectures/llm/providers.py), which as of November 2026 is:
#   nebius      -> nvidia/Nemotron-3_5-Lightning
#   openai      -> gpt-6-luna
#   anthropic   -> claude-sonnet-5-5
#   deepseek    -> deepseek-flash
#   groq        -> openai/gpt-oss-120b
#   ollama      -> qwen3:8b
#   together    -> openai/gpt-oss-120b
#   fireworks   -> accounts/fireworks/models/glm-5p3-flash
#   mistralai   -> mistral-large-latest
#   google      -> gemini-3.5-flash-lite
#   openrouter  -> openai/gpt-oss-120b
# Providers retire models often. If yours stops answering, set the replacement its
# deprecation page names here.
LLM_MODEL=

# The model the notebooks use where a reasoning ("thinking") model makes the difference,
# e.g. deepseek-v4-pro, or qwen3:14b on Ollama. Empty means the same as LLM_MODEL.
LLM_REASONING_MODEL=

# Default sampling temperature (architectures override per-node when needed).
LLM_TEMPERATURE=0.0

# ---------------------------------------------------------------------------
# 2.  PROVIDER API KEYS: only fill in the one(s) you use
# ---------------------------------------------------------------------------
NEBIUS_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
MISTRAL_API_KEY=
GOOGLE_API_KEY=
# One OpenRouter key reaches hundreds of models (MiniMax, Qwen, DeepSeek, ...).
OPENROUTER_API_KEY=

# Ollama runs locally; no key needed. Override the host if not on default port.
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# 3.  WEB SEARCH (used by ToolUse, ReAct, Planning, PEV, Multi-Agent, ...)
# ---------------------------------------------------------------------------
# tavily: needs TAVILY_API_KEY. Free tier at https://app.tavily.com (1000 calls / month).
# mcp:    no key and no signup: the search tool of the MCP server at SEARCH_MCP_URL,
#         Parallel's free, keyless search server by default. Needs the [mcp] extra.
SEARCH_BACKEND=tavily
TAVILY_API_KEY=
SEARCH_MCP_URL=https://search.parallel.ai/mcp

# ---------------------------------------------------------------------------
# 4.  LANGSMITH TRACING (highly recommended, the free tier is generous)
# ---------------------------------------------------------------------------
# When set, every agent run is traced at https://smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=all-agentic-architectures
LANGCHAIN_TRACING_V2=true

# ---------------------------------------------------------------------------
# 5.  VECTOR STORE (used by RAG + episodic memory notebooks)
# ---------------------------------------------------------------------------
# memory (default): langchain-core's in-process store, no extra package
# faiss (local, [faiss] extra) | chroma (local) | qdrant (server)
VECTOR_BACKEND=memory

# Only needed if VECTOR_BACKEND=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ---------------------------------------------------------------------------
# 6.  GRAPH DATABASE (used by graph-memory + GraphRAG notebooks)
# ---------------------------------------------------------------------------
# `docker compose up neo4j` brings up a local instance matching these defaults.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme_local_only

# ---------------------------------------------------------------------------
# 7.  EMBEDDINGS PROVIDER (defaults to LLM_PROVIDER unless overridden)
# ---------------------------------------------------------------------------
# Leave blank to inherit from LLM_PROVIDER above, or set explicitly:
#   nebius (Qwen/Qwen3-Embedding-8B) | openai (text-embedding-3-small) |
#   google (models/gemini-embedding-2) | ollama (nomic-embed-text) |
#   huggingface (sentence-transformers/all-MiniLM-L6-v2, local)
# A provider without an embeddings model (anthropic, groq, deepseek, ...) falls back
# to the local Hugging Face one, which needs the [huggingface] extra.
EMBEDDINGS_PROVIDER=
EMBEDDINGS_MODEL=
